# --- Base de données (étape 1) ---
# MySQL 8. Encoder les caractères spéciaux du mot de passe (@ -> %40, : -> %3A, / -> %2F).
DATABASE_URL="mysql://utilisateur:motdepasse@hote:3306/base"

# --- Auth admin (étape 1) ---
# Un seul e-mail Google autorise l'acces a /admin.
ADMIN_EMAIL="coach@example.com"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Auth.js fait confiance a l'en-tete Host uniquement sur Vercel. En local ou
# derriere un autre proxy, mettre "true" sinon la connexion admin echoue.
AUTH_TRUST_HOST="true"
# URL publique du site (sans slash final).
NEXT_PUBLIC_APP_URL="https://cisspbootcamp.online"

# --- E-mail transactionnel (étape 2) ---
RESEND_API_KEY=""
EMAIL_FROM="Ben — CISSP Bootcamp <bonjour@cisspbootcamp.online>"

# --- Google Calendar (étape 3) ---
# Meme client OAuth que l'auth admin (AUTH_GOOGLE_ID/SECRET). Ajouter dans la
# console Google l'URI de redirection ${NEXT_PUBLIC_APP_URL}/api/google/callback
# et activer l'API Google Calendar. Le compte qui autorise l'agenda peut etre
# different de ADMIN_EMAIL : c'est celui qui clique sur "Connecter" dans l'admin.
# Cle AES-256 chiffrant le refresh token en base : openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --- Paiement (étape 4) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NETTICKET_API_KEY=""
NETTICKET_EVENT_REFERENCE=""
# Valeur renvoyee dans l'en-tete verif-hash (voir docs/NETTICKET.md).
NETTICKET_WEBHOOK_SECRET=""
NETTICKET_FALLBACK_URL=""

# --- IA (étape 2 bis) ---
# Redige le message de relance commerciale que Ben valide dans l'admin.
# Sans cle, un gabarit sans IA est utilise. Le diagnostic, lui, reste calcule par
# les regles de lib/scoring.ts — jamais par l'IA.
ANTHROPIC_API_KEY=""

# --- Cron Vercel ---
# Protege /api/cron/* : en-tete Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# --- Tests (jamais sur Vercel) ---
# Remplace Google Calendar par un agenda fictif pour le parcours Playwright
# (tests/e2e/journey.spec.ts). Sur Vercel, cette variable ne doit pas exister.
# E2E_CALENDAR_STUB="1"
