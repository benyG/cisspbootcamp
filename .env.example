# --- Base de données (étape 1) ---
# MySQL 8. Encoder les caractères spéciaux du mot de passe (@ -> %40, : -> %3A, / -> %2F).
DATABASE_URL="mysql://utilisateur:motdepasse@hote:3306/base"

# --- Auth admin (étape 1) ---
# Un seul e-mail Google autorise l'acces a /admin.
ADMIN_EMAIL="coach@example.com"
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Auth.js fait confiance a l'en-tete Host uniquement sur Vercel. En local ou
# derriere un autre proxy, mettre "true" sinon la connexion admin echoue.
AUTH_TRUST_HOST="true"
# URL publique du site (sans slash final).
NEXT_PUBLIC_APP_URL="https://cisspbootcamp.online"

# --- E-mail transactionnel (étape 2) ---
RESEND_API_KEY=""
EMAIL_FROM="Ben — CISSP Bootcamp <bonjour@cisspbootcamp.online>"

# --- Google Calendar (étape 3) ---
# Redirect OAuth : ${NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CALENDAR_ID=""
# Cle AES-256 (base64, 32 octets) chiffrant le refresh token stocke en base.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --- Paiement (étape 4) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
NETTICKET_API_KEY=""
NETTICKET_MERCHANT_ID=""
NETTICKET_WEBHOOK_SECRET=""
NETTICKET_FALLBACK_URL=""

# --- Cron Vercel ---
# Protege /api/cron/* : en-tete Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
