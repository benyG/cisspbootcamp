// Schema V1 — see docs/SPECS.md, Partie C.
// Money is stored in cents; USD is the reference currency.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  new
  contacted
  booked
  called
  registered
  nurture
  lost
}

enum Readiness {
  ready
  conditional
  not_yet
}

enum BookingStatus {
  scheduled
  done
  no_show
  cancelled
}

/// Outcome the coach records after the discovery call (SPECS A3).
enum BookingOutcome {
  registered
  to_follow_up
  not_now
  not_qualified
  no_show
}

enum CohortStatus {
  planned
  open
  full
  running
  done
}

enum PaymentMethod {
  stripe
  netticket
}

enum RegistrationStatus {
  pending
  pending_manual
  paid
  refunded
}

enum MessageChannel {
  email
  whatsapp
}

/// A diagnosis reaches the prospect only once the coach has approved it.
enum DiagnosisStatus {
  pending_review
  approved
  sent
  set_aside
}

model Lead {
  id        Int     @id @default(autoincrement())
  firstName String  @map("first_name") @db.VarChar(80)
  lastName  String  @map("last_name") @db.VarChar(80)
  email     String  @unique @db.VarChar(180)
  whatsapp  String? @db.VarChar(32)
  country   String  @db.VarChar(2)

  /// Pricing tier code resolved from `country` (see PricingTier).
  tier      String     @db.VarChar(32)
  status    LeadStatus @default(new)
  heatScore Int        @default(0) @map("heat_score")
  readiness Readiness?

  /// Free text from the capture step: context for the call, never scored.
  jobTitle String? @map("job_title") @db.VarChar(120)
  goals    String? @db.Text

  /// Explicit, timestamped RGPD consent. Null means never consented.
  consentAt DateTime? @map("consent_at")
  source    String?   @db.VarChar(80)

  utmSource   String? @map("utm_source") @db.VarChar(120)
  utmMedium   String? @map("utm_medium") @db.VarChar(120)
  utmCampaign String? @map("utm_campaign") @db.VarChar(120)
  utmContent  String? @map("utm_content") @db.VarChar(120)
  utmTerm     String? @map("utm_term") @db.VarChar(120)

  nextFollowupAt DateTime? @map("next_followup_at")
  /// How many follow-ups have gone out since the last stage change (J+2, then J+7).
  followupCount  Int       @default(0) @map("followup_count")

  /// Coach's free notes and tags (SPECS A7).
  notes String? @db.Text
  tags  Json?

  /// One-click unsubscribe (SPECS A10, Partie D).
  unsubscribeToken String    @unique @map("unsubscribe_token") @db.VarChar(64)
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  scannerResponses ScannerResponse[]
  funnelEvents     FunnelEvent[]
  seatHolds        SeatHold[]
  bookings         Booking[]
  registrations    Registration[]
  actions          ActionLog[]
  pricingTier      PricingTier       @relation(fields: [tier], references: [code])

  @@index([status, heatScore])
  @@index([nextFollowupAt])
  @@index([tier])
  @@map("leads")
}

model ScannerResponse {
  id     Int  @id @default(autoincrement())
  leadId Int  @map("lead_id")
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Raw questionnaire answers, kept verbatim so scoring can be replayed.
  answers   Json
  readiness Readiness
  heatScore Int       @map("heat_score")

  /// Frozen output of lib/analysis.ts at submission time (axes, timeline).
  analysis Json

  /// Generated message, then whatever the coach rewrote before approving.
  coachMessage String @map("coach_message") @db.Text

  status     DiagnosisStatus @default(pending_review)
  reviewedAt DateTime?       @map("reviewed_at")
  sentAt     DateTime?       @map("sent_at")

  /// Opaque token addressing /scanner/resultat/[token]; inert until approved.
  resultToken String @unique @map("result_token") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId])
  @@index([status, createdAt])
  @@map("scanner_responses")
}

model Booking {
  id     Int  @id @default(autoincrement())
  leadId Int  @map("lead_id")
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  googleEventId String? @unique @map("google_event_id") @db.VarChar(180)
  meetUrl       String? @map("meet_url") @db.VarChar(255)

  startsAt DateTime @map("starts_at")
  endsAt   DateTime @map("ends_at")

  /// IANA timezone the prospect booked in, shown back on every reminder.
  timezone String @db.VarChar(64)

  status  BookingStatus   @default(scheduled)
  outcome BookingOutcome?
  notes   String?         @db.Text

  rescheduleToken String @unique @map("reschedule_token") @db.VarChar(64)

  remindedAt24h DateTime? @map("reminded_at_24h")
  remindedAt1h  DateTime? @map("reminded_at_1h")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([startsAt])
  @@index([leadId])
  @@map("bookings")
}

model Cohort {
  id       Int          @id @default(autoincrement())
  name     String       @db.VarChar(120)
  startsAt DateTime     @map("starts_at")
  endsAt   DateTime     @map("ends_at")
  capacity Int          @default(10)
  status   CohortStatus @default(planned)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  registrations Registration[]
  seatHolds     SeatHold[]

  @@index([status, startsAt])
  @@map("cohorts")
}

model Registration {
  id       Int    @id @default(autoincrement())
  leadId   Int    @map("lead_id")
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cohortId Int    @map("cohort_id")
  cohort   Cohort @relation(fields: [cohortId], references: [id])

  tier String @db.VarChar(32)

  /// Reference amount, in USD cents.
  amountUsd Int @map("amount_usd")

  /// Indicative local amount shown at checkout, in minor units.
  currencyLocal String? @map("currency_local") @db.VarChar(3)
  amountLocal   Int?    @map("amount_local")

  method PaymentMethod
  status RegistrationStatus @default(pending)

  stripeSessionId        String? @unique @map("stripe_session_id") @db.VarChar(255)
  netticketTransactionId String? @unique @map("netticket_transaction_id") @db.VarChar(255)

  /// Our own unique reference, carried through both payment flows.
  reference String @unique @db.VarChar(40)

  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([cohortId, status])
  @@index([leadId])
  @@map("registrations")
}

model PricingTier {
  code                String  @id @db.VarChar(32)
  /// Price in USD cents; 0 means "on request" (enterprise).
  amountUsd           Int     @map("amount_usd")
  /// ISO 3166-1 alpha-2 country codes mapped to this tier.
  countries           Json
  label               String  @db.VarChar(120)
  /// Netticket ticket code selling this tier (docs/NETTICKET.md); null = no mobile money.
  netticketTicketCode String? @map("netticket_ticket_code") @db.VarChar(64)

  leads Lead[]

  @@map("pricing_tiers")
}

model Testimonial {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(120)
  role      String? @db.VarChar(120)
  country   String? @db.VarChar(2)
  text      String  @db.Text
  videoUrl  String? @map("video_url") @db.VarChar(255)
  published Boolean @default(false)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published])
  @@map("testimonials")
}

model MessageTemplate {
  key     String         @id @db.VarChar(64)
  channel MessageChannel
  subject String?        @db.VarChar(255)
  body    String         @db.Text

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("message_templates")
}

model ActionLog {
  id     Int   @id @default(autoincrement())
  leadId Int?  @map("lead_id")
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type    String          @db.VarChar(64)
  channel MessageChannel?
  payload Json?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("actions_log")
}

/// The single Google account whose calendar takes discovery calls. One row.
model GoogleCredential {
  id                 Int    @id @default(1)
  /// Account that completed the OAuth consent — may differ from ADMIN_EMAIL.
  accountEmail       String @map("account_email") @db.VarChar(180)
  /// Refresh token, AES-256-GCM (lib/crypto.ts). Never stored in clear.
  refreshTokenSealed String @map("refresh_token_sealed") @db.VarChar(512)
  calendarId         String @default("primary") @map("calendar_id") @db.VarChar(255)
  /// Zone the availability rules are written in.
  timeZone           String @default("Africa/Douala") @map("time_zone") @db.VarChar(64)

  connectedAt DateTime @default(now()) @map("connected_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("google_credentials")
}

/// Weekly availability for discovery calls, in the coach's zone (SPECS A3).
model AvailabilityRule {
  id      Int    @id @default(autoincrement())
  /// 0 = dimanche … 6 = samedi
  weekday Int
  /// "HH:MM"
  start   String @db.VarChar(5)
  end     String @db.VarChar(5)

  @@index([weekday])
  @@map("availability_rules")
}

/// Units of `currency` per 1 USD, refreshed daily by /api/cron/rates.
model ExchangeRate {
  currency  String   @id @db.VarChar(3)
  perUsd    Float    @map("per_usd")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}

/// Landing-page copy and settings Ben edits from /admin/parametres/site.
/// One row per key; the value shape is validated by lib/site-settings.ts.
model SiteSetting {
  key       String   @id @db.VarChar(64)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_settings")
}

/// One funnel event (docs/CONVERSION.md §3): first-party, no third party, no
/// personal data beyond the optional lead link. Visitors are a random cookie.
model FunnelEvent {
  id        Int     @id @default(autoincrement())
  /// Random first-party cookie, 90 days. Null for server-side events without a browser (webhooks).
  visitorId String? @map("visitor_id") @db.VarChar(48)
  leadId    Int?    @map("lead_id")
  lead      Lead?   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// landing_view, cta_click, scanner_start, scanner_step, scanner_submit, …
  name  String  @db.VarChar(40)
  /// Scanner question number for scanner_step; null otherwise.
  step  Int?
  /// The main dimension of the event: CTA position, question id, FAQ question, payment method, verdict.
  label String? @db.VarChar(160)
  /// ISO country, when known (scanner_submit, paid).
  country String? @db.VarChar(2)

  utmSource   String? @map("utm_source") @db.VarChar(120)
  utmMedium   String? @map("utm_medium") @db.VarChar(120)
  utmCampaign String? @map("utm_campaign") @db.VarChar(120)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([name, createdAt])
  @@index([visitorId, createdAt])
  @@index([leadId])
  @@map("funnel_events")
}

/// A seat kept for a prospect after the discovery call (docs/CONVERSION.md
/// §2.4): counted in the public gauge, released automatically at expiry.
model SeatHold {
  id       Int    @id @default(autoincrement())
  leadId   Int    @map("lead_id")
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cohortId Int    @map("cohort_id")
  cohort   Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  expiresAt      DateTime  @map("expires_at")
  reminderSentAt DateTime? @map("reminder_sent_at")
  releasedAt     DateTime? @map("released_at")
  /// paid | expired | manual
  releaseReason  String?   @map("release_reason") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([cohortId, releasedAt, expiresAt])
  @@index([leadId])
  @@map("seat_holds")
}
